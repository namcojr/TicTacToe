<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Quick, pleasant fade+scale transition shared by every activity -->
    <style name="Animation.TicTacToe" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/activity_fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/activity_fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/activity_fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/activity_fade_out</item>
    </style>

    <style name="Theme.TicTacToe" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/theme_default</item>
        <item name="android:fontFamily">@font/comfortaa</item>
        <item name="fontFamily">@font/comfortaa</item>
        <item name="colorPrimaryVariant">@color/theme_dark</item>
        <item name="colorOnPrimary">@color/theme_on</item>
        <item name="colorSecondary">@color/theme_blue</item>
        <item name="colorSecondaryVariant">@color/theme_dark</item>
        <item name="colorOnSecondary">@color/theme_on</item>
        <item name="android:windowBackground">@color/theme_light</item>
        <item name="android:textColorPrimary">@color/theme_on</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.TicTacToe.AlertDialog</item>
        <item name="android:windowAnimationStyle">@style/Animation.TicTacToe</item>
    </style>

