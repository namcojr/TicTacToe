<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/enter_initials"
        android:textColor="?android:textColorPrimary"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <!-- The ghost "AAA" sits behind the input; letters the player hasn't typed yet stay ghosted -->
    <FrameLayout
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_initials_input">

        <TextView
            android:id="@+id/tvGhost"
            style="@style/InitialsText"
            android:textColor="@color/dialog_text_ghost"
            android:importantForAccessibility="no" />

        <EditText
            android:id="@+id/etInitials"
            style="@style/InitialsText"
            android:background="@null"
            android:textColor="?android:textColorPrimary"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:imeOptions="actionDone"
            android:maxLength="3"
            android:importantForAutofill="no"
            android:autofillHints="" />
    </FrameLayout>
</LinearLayout>
