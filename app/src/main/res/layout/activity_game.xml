

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:windowBackground">

    <TextView
        android:id="@+id/tvPlayerTurn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Player X's Turn"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/main_title_color"
        android:layout_marginTop="96dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/boardContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:layout_marginTop="96dp"
        android:padding="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvPlayerTurn"
        app:layout_constraintBottom_toTopOf="@id/bottomButtonLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintDimensionRatio="1:1">

        <!-- Guidelines for columns (vertical) -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_col1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.333"/>
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_col2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.666"/>
        <!-- Guidelines for rows (horizontal) -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_row1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.333"/>
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_row2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.666"/>

        <!-- 3x3 Cards -->
        <!-- Row 0 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card00"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/transparent"
            app:strokeColor="@android:color/transparent"
            android:layout_margin="6dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/guideline_row1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guideline_col1">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/boardBg00"
                android:background="@android:color/transparent">
                <ImageView
                    android:id="@+id/btnCell00"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="18dp"
                    android:background="@android:color/transparent"
                    android:scaleType="centerInside"
                    android:contentDescription="Tic Tac Toe Cell" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card01"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/transparent"
            app:strokeColor="@android:color/transparent"
            android:layout_margin="6dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/guideline_row1"
            app:layout_constraintStart_toStartOf="@id/guideline_col1"
            app:layout_constraintEnd_toStartOf="@id/guideline_col2">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/boardBg01"
                android:background="@android:color/transparent">
                <ImageView
                    android:id="@+id/btnCell01"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="18dp"
                    android:background="@android:color/transparent"
                    android:scaleType="centerInside"
                    android:contentDescription="Tic Tac Toe Cell" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card02"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/transparent"
            app:strokeColor="@android:color/transparent"
            android:layout_margin="6dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/guideline_row1"
            app:layout_constraintStart_toStartOf="@id/guideline_col2"
            app:layout_constraintEnd_toEndOf="parent">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/boardBg02"
                android:background="@android:color/transparent">
                <ImageView
                    android:id="@+id/btnCell02"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="18dp"
                    android:background="@android:color/transparent"
                    android:scaleType="centerInside"
                    android:contentDescription="Tic Tac Toe Cell" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Row 1 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card10"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/transparent"
            app:strokeColor="@android:color/transparent"
            android:layout_margin="6dp"
            app:layout_constraintTop_toTopOf="@id/guideline_row1"
            app:layout_constraintBottom_toTopOf="@id/guideline_row2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guideline_col1">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/boardBg10"
                android:background="@android:color/transparent">
                <ImageView
                    android:id="@+id/btnCell10"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="18dp"
                    android:background="@android:color/transparent"
                    android:scaleType="centerInside"
                    android:contentDescription="Tic Tac Toe Cell" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card11"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/transparent"
            app:strokeColor="@android:color/transparent"
            android:layout_margin="6dp"
            app:layout_constraintTop_toTopOf="@id/guideline_row1"
            app:layout_constraintBottom_toTopOf="@id/guideline_row2"
            app:layout_constraintStart_toStartOf="@id/guideline_col1"
            app:layout_constraintEnd_toStartOf="@id/guideline_col2">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/boardBg11"
                android:background="@android:color/transparent">
                <ImageView
                    android:id="@+id/btnCell11"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="18dp"
                    android:background="@android:color/transparent"
                    android:scaleType="centerInside"
                    android:contentDescription="Tic Tac Toe Cell" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card12"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/transparent"
            app:strokeColor="@android:color/transparent"
            android:layout_margin="6dp"
            app:layout_constraintTop_toTopOf="@id/guideline_row1"
            app:layout_constraintBottom_toTopOf="@id/guideline_row2"
            app:layout_constraintStart_toStartOf="@id/guideline_col2"
            app:layout_constraintEnd_toEndOf="parent">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/boardBg12"
                android:background="@android:color/transparent">
                <ImageView
                    android:id="@+id/btnCell12"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="18dp"
                    android:background="@android:color/transparent"
                    android:scaleType="centerInside"
                    android:contentDescription="Tic Tac Toe Cell" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Row 2 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card20"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/transparent"
            app:strokeColor="@android:color/transparent"
            android:layout_margin="6dp"
            app:layout_constraintTop_toTopOf="@id/guideline_row2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guideline_col1">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/boardBg20"
                android:background="@android:color/transparent">
                <ImageView
                    android:id="@+id/btnCell20"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="18dp"
                    android:background="@android:color/transparent"
                    android:scaleType="centerInside"
                    android:contentDescription="Tic Tac Toe Cell" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card21"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/transparent"
            app:strokeColor="@android:color/transparent"
            android:layout_margin="6dp"
            app:layout_constraintTop_toTopOf="@id/guideline_row2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@id/guideline_col1"
            app:layout_constraintEnd_toStartOf="@id/guideline_col2">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/boardBg21"
                android:background="@android:color/transparent">
                <ImageView
                    android:id="@+id/btnCell21"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="18dp"
                    android:background="@android:color/transparent"
                    android:scaleType="centerInside"
                    android:contentDescription="Tic Tac Toe Cell" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card22"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/transparent"
            app:strokeColor="@android:color/transparent"
            android:layout_margin="6dp"
            app:layout_constraintTop_toTopOf="@id/guideline_row2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@id/guideline_col2"
            app:layout_constraintEnd_toEndOf="parent">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/boardBg22"
                android:background="@android:color/transparent">
                <ImageView
                    android:id="@+id/btnCell22"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="18dp"
                    android:background="@android:color/transparent"
                    android:scaleType="centerInside"
                    android:contentDescription="Tic Tac Toe Cell" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:id="@+id/bottomButtonLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="128dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <Button
            android:id="@+id/btnReset"
            style="@style/TicTacToeActionButton"
            android:text="Restart"
            android:textColor="?android:textColorPrimary"
            android:layout_marginEnd="16dp"
            android:paddingLeft="24dp"
            android:paddingRight="24dp" />
        <Button
            android:id="@+id/btnMenu"
            style="@style/TicTacToeActionButton"
            android:text="Menu"
            android:textColor="?android:textColorPrimary"
            android:paddingLeft="24dp"
            android:paddingRight="24dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
